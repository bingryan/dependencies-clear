#! /usr/bin/env bash
set -e

# Default configuration
DRY_RUN=false
AUTO_CONFIRM=false
SIZE_THRESHOLD=0  # Unit: MB, 0 means no limit
MAX_DEPTH=5       # Default scan depth
DOCKER_CLEANUP=false
DOCKER_ONLY=false
PARALLEL=true

# Directory patterns to clean (sorted by priority)
# Docker cleanup function
clean_docker() {
    local dry_run=$1
    local auto_confirm=$2

    echo ""
    echo "============================================"
    echo "           Docker Cleanup"
    echo "============================================"

    # Check Docker is running
    if ! docker info > /dev/null 2>&1; then
        echo -e "${RED}Error: Docker is not running${NC}"
        return 1
    fi

    # Show current usage
    echo "Current Docker disk usage:"
    docker system df
    echo ""

    if [[ "$dry_run" == true ]]; then
        echo -e "${YELLOW}[Dry run] The following resources would be removed:${NC}"
        echo ""

        # Dangling images with details
        local tmp_file=$(mktemp)
        docker images -f "dangling=true" --format "{{.ID}}|{{.Size}}|{{.CreatedAt}}" > "$tmp_file"
        if [[ -s "$tmp_file" ]]; then
            echo "📦 Dangling Images:"
            printf "  ${BLUE}%-20s %-15s %s${NC}\n" "ID" "Size" "Created"
            local img_count=0
            while IFS='|' read -r id size created; do
                ((img_count++))
                if [[ $img_count -le 10 ]]; then
                    printf "  %-20s %-15s %s\n" "${id:0:19}" "$size" "$created"
                fi
            done < "$tmp_file"
            local total_imgs=$(wc -l < "$tmp_file")
            if [[ $total_imgs -gt 10 ]]; then
                echo -e "  ${YELLOW}... and $((total_imgs - 10)) more${NC}"
            fi
            echo ""
        fi
        rm -f "$tmp_file"

        # Stopped containers with details
        tmp_file=$(mktemp)
        docker ps -a -f "status=exited" --format "{{.Names}}|{{.Image}}|{{.Status}}" > "$tmp_file"
        if [[ -s "$tmp_file" ]]; then
            echo "🐳 Stopped Containers:"
            printf "  ${BLUE}%-25s %-30s %s${NC}\n" "Name" "Image" "Status"
            local container_count=0
            while IFS='|' read -r name image status; do
                ((container_count++))
                if [[ $container_count -le 10 ]]; then
                    printf "  %-25s %-30s %s\n" "${name:0:24}" "${image:0:29}" "$status"
                fi
            done < "$tmp_file"
            local total_containers=$(wc -l < "$tmp_file")
            if [[ $total_containers -gt 10 ]]; then
                echo -e "  ${YELLOW}... and $((total_containers - 10)) more${NC}"
            fi
            echo ""
        fi
        rm -f "$tmp_file"

        # Unused volumes with details
        tmp_file=$(mktemp)
        docker volume ls -f "dangling=true" --format "{{.Name}}|{{.Driver}}|{{.Scope}}" > "$tmp_file"
        if [[ -s "$tmp_file" ]]; then
            echo "💾 Unused Volumes:"
            printf "  ${BLUE}%-40s %-15s %s${NC}\n" "Name" "Driver" "Scope"
            local vol_count=0
            while IFS='|' read -r name driver scope; do
                ((vol_count++))
                if [[ $vol_count -le 10 ]]; then
                    printf "  %-40s %-15s %s\n" "${name:0:39}" "$driver" "$scope"
                fi
            done < "$tmp_file"
            local total_vols=$(wc -l < "$tmp_file")
            if [[ $total_vols -gt 10 ]]; then
                echo -e "  ${YELLOW}... and $((total_vols - 10)) more${NC}"
            fi
            echo ""
        fi
        rm -f "$tmp_file"

        # Build cache info
        local cache_size=$(docker system df --format "{{.BuildCache.Size}}" | head -1)
        local cache_reclaimable=$(docker system df --format "{{.BuildCache.Reclaimable}}" | head -1)
        if [[ -n "$cache_size" && "$cache_size" != "0B" ]]; then
            echo "🔨 Build Cache:"
            echo "  Size: $cache_size"
            echo "  Reclaimable: $cache_reclaimable"
            echo ""
        fi

        echo -e "${YELLOW}Run without -d to actually remove these resources${NC}"
        return 0
    fi

    # Clean dangling images
    local images=$(docker images -f "dangling=true" -q)
    if [[ -n "$images" ]]; then
        if [[ "$auto_confirm" == false ]]; then
            echo -ne "${YELLOW}Remove dangling images? [y/N]: ${NC}"
            read -r confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                docker rmi $images > /dev/null 2>&1
                echo -e "${GREEN}✓ Removed dangling images${NC}"
            fi
        else
            docker rmi $images > /dev/null 2>&1
            echo -e "${GREEN}✓ Removed dangling images${NC}"
        fi
    fi

    # Clean stopped containers first (required before volume cleanup)
    local containers=$(docker ps -aq -f "status=exited")
    if [[ -n "$containers" ]]; then
        if [[ "$auto_confirm" == false ]]; then
            echo -ne "${YELLOW}Remove stopped containers? [y/N]: ${NC}"
            read -r confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                docker rm $containers > /dev/null 2>&1
                echo -e "${GREEN}✓ Removed stopped containers${NC}"
            fi
        else
            docker rm $containers > /dev/null 2>&1
            echo -e "${GREEN}✓ Removed stopped containers${NC}"
        fi
    fi

    # Clean unused volumes (must be done after removing containers)
    # Use --all to remove all unused volumes, not just dangling ones
    if [[ "$auto_confirm" == false ]]; then
        echo -ne "${YELLOW}Remove unused volumes? [y/N]: ${NC}"
        read -r confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            # First try with --all flag to remove all unused volumes
            local prune_output=$(docker volume prune --all -f 2>&1)
            if echo "$prune_output" | grep -q "Total reclaimed space: 0B"; then
                echo -e "${YELLOW}No unused volumes to remove${NC}"
            elif echo "$prune_output" | grep -q "Total reclaimed"; then
                echo -e "${GREEN}✓ Removed unused volumes${NC}"
            else
                echo -e "${YELLOW}No volumes were removed${NC}"
            fi
        fi
    else
        local prune_output=$(docker volume prune --all -f 2>&1)
        if echo "$prune_output" | grep -q "Total reclaimed space: 0B"; then
            echo -e "${YELLOW}No unused volumes to remove${NC}"
        elif echo "$prune_output" | grep -q "Total reclaimed"; then
            echo -e "${GREEN}✓ Removed unused volumes${NC}"
        fi
    fi

    # Clean build cache
    if [[ "$auto_confirm" == false ]]; then
        echo -ne "${YELLOW}Remove build cache? [y/N]: ${NC}"
        read -r confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            local cache_output=$(docker builder prune -f 2>/dev/null)
            # Check if output contains "0B" or is empty
            if [[ -z "$cache_output" ]] || echo "$cache_output" | grep -qE "(Total.*0B|reclaimed space.*0B)"; then
                echo -e "${YELLOW}No build cache to remove${NC}"
            else
                echo -e "${GREEN}✓ Removed build cache${NC}"
            fi
        fi
    else
        local cache_output=$(docker builder prune -f 2>/dev/null)
        if [[ -z "$cache_output" ]] || echo "$cache_output" | grep -qE "(Total.*0B|reclaimed space.*0B)"; then
            echo -e "${YELLOW}No build cache to remove${NC}"
        else
            echo -e "${GREEN}✓ Removed build cache${NC}"
        fi
    fi

    echo ""
    echo "Docker cleanup complete!"
    echo "Updated disk usage:"
    docker system df
}

# Directory patterns to clean (sorted by priority)
TARGET_PATTERNS=(
  # Node.js / JavaScript / TypeScript
  "node_modules"
  ".next"
  ".nuxt"
  ".turbo"
  "storybook-static"
  "coverage"

  # Python
  ".venv"
  "venv"
  "env"
  "__pycache__"
  ".pytest_cache"
  ".mypy_cache"
  ".ruff_cache"
  "*.egg-info"
  "*.egg"
  "dist"
  "build"
  ".tox"

  # Rust
  "target"

  # Java / Kotlin / Android
  "build"
  ".gradle"

  # Go
  "bin"
  "vendor"

  # .NET
  "bin"
  "obj"

  # Tauri specific
  "src-tauri/target"
  "src-tauri/gen"
  "src-tauri/WixTools"

  # General build outputs
  "dist"
  "dist-ssr"
  "out"
  "build"
  "release"
  "*.local"
  ".cache"
  ".parcel-cache"
  ".rollup.cache"
)

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Show help
show_help() {
    cat << EOF
$(basename "$0") - Clean project dependency directories to free up disk space

Usage: $(basename "$0") [options] [directory]

Arguments:
  directory     Root directory to scan (default: current directory)

Options:
  -h, --help          Show this help message
  -d, --dry-run       Preview mode, only show directories to be deleted
  -y, --yes           Auto confirm without interactive confirmation
  -s, --size N        Only show/delete directories larger than N MB (default: 0 = all)
  -m, --maxdepth N    Maximum directory depth to scan (default: 5)
  --docker            Also clean up Docker images and containers
  --only-docker       Only clean Docker resources, skip directory scanning
  --no-parallel       Disable parallel size calculation

Examples:
  $(basename "$0")                    # Scan current directory with interactive confirmation
  $(basename "$0") ~/projects         # Scan ~/projects directory
  $(basename "$0") -d                 # Preview mode, see what will be deleted
  $(basename "$0") -s 100 -y          # Auto delete dependency directories larger than 100MB
  $(basename "$0") ~/code -d -s 50    # Preview directories larger than 50MB
  $(basename "$0") -m 7 ~/projects    # Scan up to 7 levels deep
  $(basename "$0") --docker           # Clean project dependencies and Docker resources
  $(basename "$0") --only-docker -y   # Clean only Docker resources, auto-confirm

EOF
}

# 解析参数
POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -y|--yes)
            AUTO_CONFIRM=true
            shift
            ;;
        -s|--size)
            SIZE_THRESHOLD="$2"
            shift 2
            ;;
        -m|--maxdepth)
            MAX_DEPTH="$2"
            shift 2
            ;;
        --docker)
            DOCKER_CLEANUP=true
            shift
            ;;
        --only-docker)
            DOCKER_ONLY=true
            DOCKER_CLEANUP=true
            shift
            ;;
        --no-parallel)
            PARALLEL=false
            shift
            ;;
        -*)
            echo "Unknown option: $1"
            show_help
            exit 1
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done

set -- "${POSITIONAL[@]}"

# Handle --only-docker mode (skip directory scanning)
if [[ "$DOCKER_ONLY" == true ]]; then
    clean_docker "$DRY_RUN" "$AUTO_CONFIRM"
    exit 0
fi

# Set scan directory
SCAN_DIR="${1:-$(pwd)}"

if [[ ! -d "$SCAN_DIR" ]]; then
    echo -e "${RED}Error: Directory does not exist: $SCAN_DIR${NC}"
    exit 1
fi

echo -e "${BLUE}Scan directory: $SCAN_DIR${NC}"
echo -e "${BLUE}Size threshold: ${SIZE_THRESHOLD}MB${NC}"
echo -e "${BLUE}Max depth: ${MAX_DEPTH}${NC}"
if [[ "$DRY_RUN" == true ]]; then
    echo -e "${YELLOW}[Dry run] No files will be deleted${NC}"
fi
echo ""

# Get directory size in bytes
get_dir_size() {
    local dir="$1"
    # macOS du doesn't support -b, use -k (KB) then multiply by 1024
    local kb_size=$(du -sk "$dir" 2>/dev/null | cut -f1)
    echo $((kb_size * 1024))
}

# Get human-readable size (pure bash, no bc dependency)
human_readable_size() {
    local size=$1
    local unit="B"
    local value=$size

    if (( size > 1073741824 )); then
        # GB with 2 decimal places using integer math
        value=$((size * 100 / 1073741824))
        local integer_part=$((value / 100))
        local decimal_part=$((value % 100))
        # Pad decimal part with leading zero if needed
        if (( decimal_part < 10 )); then
            echo "${integer_part}.0${decimal_part}GB"
        else
            echo "${integer_part}.${decimal_part}GB"
        fi
        return
    elif (( size > 1048576 )); then
        # MB with 1 decimal place using integer math
        value=$((size * 10 / 1048576))
        local integer_part=$((value / 10))
        local decimal_part=$((value % 10))
        echo "${integer_part}.${decimal_part}MB"
        return
    elif (( size > 1024 )); then
        value=$((size / 1024))
        unit="KB"
    fi

    echo "${value}${unit}"
}

# Use regular arrays to store results (compatible with bash 3.2)
FOUND_DIRS_LIST=()

# Check if directory already exists in the list (or as a subdirectory)
dir_exists_or_child() {
    local check_dir="$1"
    for existing in "${FOUND_DIRS_LIST[@]}"; do
        if [[ "$check_dir" == "$existing"/* ]] || [[ "$check_dir" == "$existing" ]]; then
            return 0  # Already exists or is a subdirectory
        fi
    done
    return 1  # Not found
}

# Find all matching directories
echo "🔍 Scanning for dependency directories..."

for pattern in "${TARGET_PATTERNS[@]}"; do
    # Use -path for patterns with separators, -name for others
    if [[ "$pattern" == */* ]]; then
        # e.g., src-tauri/target
        find_pattern="-path"
        find_expr="*/$pattern"
    else
        # e.g., node_modules
        find_pattern="-name"
        find_expr="$pattern"
    fi

    while IFS= read -r -d '' dir; do
        # Skip nested dependency directories (avoid duplicates)
        # node_modules inside node_modules
        if [[ "$dir" == *"node_modules"* ]] && [[ "$dir" != */node_modules ]]; then
            continue
        fi
        # target inside target (edge cases)
        if [[ "$dir" == *"/target/"* ]] && [[ "$dir" != */target ]]; then
            continue
        fi
        # src-tauri/target nesting (unlikely but for safety)
        if [[ "$dir" == *"src-tauri/target"* ]] && [[ "$dir" != */src-tauri/target ]]; then
            continue
        fi

        # Check if a parent directory is already recorded (avoid duplicates)
        if ! dir_exists_or_child "$dir"; then
            FOUND_DIRS_LIST+=("$dir")
        fi
    done < <(find "$SCAN_DIR" -maxdepth $MAX_DEPTH $find_pattern "$find_expr" -type d -print0 2>/dev/null || true)
done

# Check if any directories were found
if [[ ${#FOUND_DIRS_LIST[@]} -eq 0 ]]; then
    echo -e "${GREEN}No dependency directories found!${NC}"
    # If Docker cleanup is enabled, proceed with it even if no dirs found
    if [[ "$DOCKER_CLEANUP" == true ]]; then
        clean_docker "$DRY_RUN" "$AUTO_CONFIRM"
    fi
    exit 0
fi

echo "📊 Calculating directory sizes..."

# Calculate sizes (serial, compatible with bash 3.2)
DIR_SIZES_LIST=()
for dir in "${FOUND_DIRS_LIST[@]}"; do
    size=$(get_dir_size "$dir")
    DIR_SIZES_LIST+=("$size")
done

# Filter and prepare for display
declare -a TO_DELETE
declare -a TO_DELETE_SIZES
declare -a TO_DELETE_HUMAN
TOTAL_SIZE=0

for i in "${!FOUND_DIRS_LIST[@]}"; do
    dir="${FOUND_DIRS_LIST[$i]}"
    size="${DIR_SIZES_LIST[$i]}"
    size_mb=$((size / 1048576))

    # Apply size threshold filter
    if (( size_mb >= SIZE_THRESHOLD )); then
        TO_DELETE+=("$dir")
        TO_DELETE_SIZES+=("$size")
        TO_DELETE_HUMAN+=("$(human_readable_size $size)")
        TOTAL_SIZE=$((TOTAL_SIZE + size))
    fi
done

# Sort by size (bubble sort)
for ((i=0; i<${#TO_DELETE[@]}; i++)); do
    for ((j=i+1; j<${#TO_DELETE[@]}; j++)); do
        if [[ ${TO_DELETE_SIZES[$j]} -gt ${TO_DELETE_SIZES[$i]} ]]; then
            # Swap directory
            tmp="${TO_DELETE[$i]}"
            TO_DELETE[$i]="${TO_DELETE[$j]}"
            TO_DELETE[$j]="$tmp"
            # Swap size
            tmp="${TO_DELETE_SIZES[$i]}"
            TO_DELETE_SIZES[$i]="${TO_DELETE_SIZES[$j]}"
            TO_DELETE_SIZES[$j]="$tmp"
            # Swap human-readable size
            tmp="${TO_DELETE_HUMAN[$i]}"
            TO_DELETE_HUMAN[$i]="${TO_DELETE_HUMAN[$j]}"
            TO_DELETE_HUMAN[$j]="$tmp"
        fi
    done
done

# Display results
if [[ ${#TO_DELETE[@]} -eq 0 ]]; then
    echo -e "${GREEN}No directories match the size threshold (${SIZE_THRESHOLD}MB)${NC}"
    # If Docker cleanup is enabled, still proceed with it
    if [[ "$DOCKER_CLEANUP" == true ]]; then
        clean_docker "$DRY_RUN" "$AUTO_CONFIRM"
    fi
    exit 0
fi

echo ""
echo "============================================"
echo "           Directories to Clean             "
echo "============================================"
printf "%-12s %s\n" "Size" "Path"
echo "--------------------------------------------"

for i in "${!TO_DELETE[@]}"; do
    size_human="${TO_DELETE_HUMAN[$i]}"
    dir="${TO_DELETE[$i]}"
    # Truncate long paths
    display_dir="$dir"
    if [[ ${#display_dir} -gt 60 ]]; then
        display_dir="...${display_dir: -57}"
    fi
    printf "%-12s %s\n" "$size_human" "$display_dir"
done

echo "--------------------------------------------"
printf "%-12s %s\n" "$(human_readable_size $TOTAL_SIZE)" "Total"
echo "============================================"
echo ""

# In dry-run mode, skip actual deletion but still show Docker preview
if [[ "$DRY_RUN" == true ]]; then
    echo -e "${YELLOW}Dry run complete, no files were deleted${NC}"
    # If Docker cleanup is enabled, show its preview too
    if [[ "$DOCKER_CLEANUP" == true ]]; then
        clean_docker "$DRY_RUN" "$AUTO_CONFIRM"
    fi
    exit 0
fi

# Confirm deletion
if [[ "$AUTO_CONFIRM" == false ]]; then
    echo -ne "${YELLOW}Confirm deletion of all directories above? [y/N]: ${NC}"
    read -r confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Operation cancelled${NC}"
        exit 0
    fi
fi

# Execute deletion
echo ""
echo "🗑️  Deleting..."
deleted_count=0
failed_count=0

for i in "${!TO_DELETE[@]}"; do
    dir="${TO_DELETE[$i]}"
    size_human="${TO_DELETE_HUMAN[$i]}"

    if rm -rf "$dir" 2>/dev/null; then
        echo -e "${GREEN}✓${NC} $size_human - $dir"
        ((deleted_count++))
    else
        echo -e "${RED}✗${NC} Failed to delete: $dir"
        ((failed_count++))
    fi
done

echo ""
echo "============================================"
echo -e "${GREEN}Space freed: $(human_readable_size $TOTAL_SIZE)${NC}"
echo "Successfully deleted: $deleted_count directories"
if [[ $failed_count -gt 0 ]]; then
    echo -e "${RED}Failed to delete: $failed_count directories${NC}"
fi
echo "============================================"

# Docker cleanup
if [[ "$DOCKER_CLEANUP" == true ]]; then
    clean_docker "$DRY_RUN" "$AUTO_CONFIRM"
fi
